# Tắt chính sách "minimum release age" của pnpm (mặc định ở bản pnpm mới,
# chặn cài package vừa publish gần đây để chống supply-chain attack).
# Lockfile của repo này đã được review ở mỗi PR trước khi merge — không cần
# thêm lớp chặn theo thời gian publish, và nó gây fail build không liên quan
# tới code khi Docker image trên server resolve 1 bản pnpm mới hơn CI.
minimum-release-age=0
