// K-Platform — Prisma schema
// Mirrors the ERD in README.md / SRS Section VII (Thiết kế cơ sở dữ liệu cốt lõi).
// Task: P0-04 (schema) / P0-05 (migration) / P1-01 (role field + password reset tokens).

// output tùy chỉnh (thay vì mặc định trong node_modules/.prisma/client): `pnpm deploy`
// dùng để đóng gói backend cho Docker không copy đúng node_modules/.prisma khi build
// trên pnpm v10 (lỗi "Cannot find module '.prisma/client/default'" lúc runtime) — generate
// thẳng ra thư mục trong package thì luôn được copy cùng, không phụ thuộc cấu trúc
// node_modules của pnpm.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ActiveMode {
  A // Bên A — Advertiser
  B // Bên B — Publisher
}

// Vai trò staff theo phân cấp RBAC (README.md § II). Bên A/Bên B không phải
// role riêng — chúng là `activeMode` của role USER.
enum UserRole {
  USER
  MODERATOR
  ADMIN
  ROOT_ADMIN
}

enum BmcTopupStatus {
  PENDING_MANUAL_VERIFICATION
  APPROVED
  REJECTED
}

// Loại biến động trong sổ cái ví (P2-09). Mở rộng ở phase sau: TOPUP_BMC (P6),
// TASK_REWARD/CAMPAIGN_REFUND (P4/P5).
enum WalletTxType {
  TOPUP_SEPAY
  WITHDRAWAL_REQUEST
  CAMPAIGN_RESERVE
  // P4-10 — Approve Proof (thủ công hoặc Auto-Approve 48h): tiền thưởng rời
  // escrow của Campaign (Bên A) sang ví Bên B.
  TASK_REWARD
  // Phí 1 lần kích hoạt Tài khoản Dịch vụ (mở khoá tạo Campaign) — số tiền
  // cấu hình được qua CMS Cài Đặt > Cài đặt phí kích hoạt.
  ACCOUNT_ACTIVATION
  // Admin duyệt lệnh rút tiền — tiền rời khỏi hệ thống thật (khác
  // WITHDRAWAL_REQUEST chỉ mới khoá/reserve lúc user bấm gửi lệnh).
  WITHDRAWAL_COMPLETED
  // Admin từ chối lệnh rút — hoàn trả (giải phóng) phần reserved_kpoint đã
  // khoá lúc user lập lệnh, không đổi balance_kpoint.
  WITHDRAWAL_REJECTED
}

// Bên nào trong SRS Section II mà giao dịch này thuộc về — dùng để lọc Lịch
// sử giao dịch theo Switch Mode (P2-09). SHARED = hiện ở cả 2 bên (nạp/rút).
enum WalletTxSide {
  A
  B
  SHARED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CampaignStatus {
  ACTIVE
  ARCHIVED
}

// Vòng đời đầy đủ 1 Submission, từ lúc Bên B ứng tuyển Survey (Phase 3, FN-CAMP-02)
// tới lúc nộp Proof & được duyệt (Phase 4, FN-TASK-01/02) — khớp README.md § 9.5:
// cùng 1 submissionId xuyên suốt applicationId ban đầu.
enum SubmissionStatus {
  APPLIED // Đã nộp Survey, chờ Bên A Invite/Reject
  INVITED // Bên A đã Invite, chờ Bên B nộp Proof
  REJECTED_APPLICATION // Bên A từ chối đơn ứng tuyển (khác với từ chối Proof)
  PENDING // Đã nộp Proof, chờ duyệt (người hoặc Auto-Approve 48h)
  APPROVED
  REJECTED
  DISPUTED
}

enum DisputeStatus {
  OPEN
  RECOMMENDED
  RESOLVED
}

enum ModRecommendation {
  PEND_APP
  PEND_REJ
}

enum DisputeDecision {
  APPROVE
  REJECT
}

enum AuditActionType {
  CREATE
  UPDATE
  DELETE
  DISPUTE_RESOLVE
  MANUAL_TOPUP
}

enum AuditLevel {
  INFO
  WARNING
  CRITICAL
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String     @map("password_hash")
  activeMode      ActiveMode @default(A) @map("active_mode")
  role            UserRole   @default(USER)
  trustScore      Int        @default(100) @map("trust_score")
  fingerprintHash String?    @map("fingerprint_hash")
  // Mã ngắn duy nhất dùng làm nội dung chuyển khoản SePay (`KLP_<topupCode>`,
  // P2-04) — sinh lười lúc user xin QR lần đầu, không phải lúc đăng ký, nên
  // user cũ (trước migration này) vẫn luôn null cho tới khi họ vào ví.
  topupCode       String?    @unique @map("topup_code")
  // null = Tài khoản Dịch vụ chưa kích hoạt (không được tạo Campaign). Mở
  // chế độ Dịch vụ (activeMode=A) luôn miễn phí — chỉ cần trả phí 1 lần ở
  // đây mới mở khoá được chức năng tạo Campaign (AccountActivationService).
  serviceActivatedAt DateTime? @map("service_activated_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  wallet                 Wallet?
  walletTransactions     WalletTransaction[]
  withdrawals            Withdrawal[]
  bmcTopups              BmcTopup[]           @relation("BmcTopupRequester")
  bmcTopupsVerified      BmcTopup[]           @relation("BmcTopupVerifier")
  campaignsOwned         Campaign[]           @relation("CampaignOwner")
  submissionsAsPublisher Submission[]         @relation("SubmissionPublisher")
  disputesAsModerator    DisputeTicket[]      @relation("DisputeModerator")
  disputesAsAdmin        DisputeTicket[]      @relation("DisputeAdmin")
  auditLogs              AuditLog[]           @relation("AuditActor")
  passwordResetTokens    PasswordResetToken[]
  settingsUpdated        SystemSetting[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model RolePermission {
  id             String @id @default(uuid())
  roleName       String @map("role_name")
  permissionCode String @map("permission_code")

  @@unique([roleName, permissionCode])
  @@map("roles_permissions")
}

model Wallet {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  balanceKpoint  BigInt   @default(0) @map("balance_kpoint")
  reservedKpoint BigInt   @default(0) @map("reserved_kpoint")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

// Sổ cái ví (P2-09) — mọi thao tác cộng/trừ `balance_kpoint`/`reserved_kpoint`
// đều phải ghi 1 dòng ở đây trong cùng transaction ACID với lần update Wallet
// tương ứng, để có lịch sử tra cứu được (khác với Wallet chỉ giữ số dư hiện tại).
model WalletTransaction {
  id                  String       @id @default(uuid())
  userId              String       @map("user_id")
  type                WalletTxType
  side                WalletTxSide @default(SHARED)
  balanceDeltaKpoint  BigInt       @default(0) @map("balance_delta_kpoint")
  reservedDeltaKpoint BigInt       @default(0) @map("reserved_delta_kpoint")
  // Mã giao dịch SePay (field `id`) — @unique là chốt chặn idempotency (P2-06):
  // webhook gọi lại cùng txnId sẽ bị chặn bởi constraint này, không cộng 2 lần.
  txnId               String?      @unique @map("txn_id")
  relatedCampaignId   String?      @map("related_campaign_id")
  note                String?
  createdAt           DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

// P2-08 — lệnh rút tiền về ngân hàng, trạng thái PENDING khi tạo. Duyệt/từ
// chối (Admin) là P7-09, ngoài phạm vi Phase 2.
model Withdrawal {
  id                String           @id @default(uuid())
  userId            String           @map("user_id")
  amountKpoint      BigInt           @map("amount_kpoint")
  bankId            String           @map("bank_id")
  bankAccountNumber String           @map("bank_account_number")
  bankAccountName   String           @map("bank_account_name")
  status            WithdrawalStatus @default(PENDING)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("withdrawals")
}

model BmcTopup {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  amountUsd    Decimal        @map("amount_usd") @db.Decimal(12, 2)
  kpointAmount BigInt         @map("kpoint_amount")
  txnId        String         @unique @map("txn_id")
  receiptUrl   String         @map("receipt_url")
  status       BmcTopupStatus @default(PENDING_MANUAL_VERIFICATION)
  verifiedById String?        @map("verified_by")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  user       User  @relation("BmcTopupRequester", fields: [userId], references: [id])
  verifiedBy User? @relation("BmcTopupVerifier", fields: [verifiedById], references: [id])

  @@map("bmc_topups")
}

model Campaign {
  id              String         @id @default(uuid())
  ownerId         String         @map("owner_id")
  title           String
  platform        String
  location        String?
  totalSlots      Int            @map("total_slots")
  rewardPerSlot   BigInt         @map("reward_per_slot")
  dripFeedLimit   Int            @map("drip_feed_limit")
  minTrustScore   Int            @default(0) @map("min_trust_score")
  // Mảng câu hỏi Survey sàng lọc (FN-CAMP-01/SCR-04), vd:
  // [{ "question": "...", "answerType": "YES_NO" | "TEXT", "requiresReceipt": true }]
  surveyQuestions Json?          @map("survey_questions")
  status          CampaignStatus @default(ACTIVE)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  owner       User         @relation("CampaignOwner", fields: [ownerId], references: [id])
  submissions Submission[]

  @@map("campaigns")
}

model Submission {
  id              String           @id @default(uuid())
  campaignId      String           @map("campaign_id")
  publisherId     String           @map("publisher_id")
  // Câu trả lời Survey lúc ứng tuyển (FN-CAMP-02) — khớp surveyQuestions của Campaign.
  surveyAnswers   Json?            @map("survey_answers")
  fingerprintHash String?          @map("fingerprint_hash")
  ip              String?
  proofUrl        String?          @map("proof_url")
  watermarkUrl    String?          @map("watermark_url")
  // Ngữ cảnh Bên A xem khi duyệt Proof (P4-02/SCR-07) — link bài review công
  // khai + tóm tắt nội dung, không phải field bắt buộc theo FN-TASK-01 (chỉ
  // file mới bắt buộc) nhưng UI cần để Bên A đối chiếu.
  reviewUrl       String?          @map("review_url")
  reviewNote      String?          @map("review_note")
  // Lý do Bên A từ chối Proof (P4-10 mở rộng cho Phase 5) — hiển thị cho Bên B
  // + Moderator/Admin ở CMS Dispute Center khi Bên B khiếu nại (FN-DISP-01/02).
  rejectReason    String?          @map("reject_reason")
  status          SubmissionStatus @default(APPLIED)
  autoApproveAt   DateTime?        @map("auto_approve_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  campaign  Campaign       @relation(fields: [campaignId], references: [id])
  publisher User           @relation("SubmissionPublisher", fields: [publisherId], references: [id])
  dispute   DisputeTicket?

  // Bên B chỉ ứng tuyển/nhận tối đa 1 slot/campaign (P4-08) — chặn luôn từ bước apply.
  @@unique([campaignId, publisherId])
  @@index([campaignId, fingerprintHash])
  @@index([campaignId, ip])
  @@map("submissions")
}

model DisputeTicket {
  id                String             @id @default(uuid())
  submissionId      String             @unique @map("submission_id")
  // Lý do Bên B khiếu nại, nhập lúc tạo Dispute (FN-DISP-01, SRS README § 9.5 API).
  reason            String
  modId             String?            @map("mod_id")
  modRecommendation ModRecommendation? @map("mod_recommendation")
  adminId           String?            @map("admin_id")
  finalDecision     DisputeDecision?   @map("final_decision")
  status            DisputeStatus      @default(OPEN)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  submission Submission @relation(fields: [submissionId], references: [id])
  moderator  User?      @relation("DisputeModerator", fields: [modId], references: [id])
  admin      User?      @relation("DisputeAdmin", fields: [adminId], references: [id])

  @@map("disputes")
}

model AuditLog {
  id             String          @id @default(uuid())
  actorId        String          @map("actor_id")
  targetResource String          @map("target_resource")
  actionType     AuditActionType @map("action_type")
  level          AuditLevel      @default(INFO)
  payloadBefore  Json?           @map("payload_before")
  payloadAfter   Json?           @map("payload_after")
  ip             String?
  createdAt      DateTime        @default(now()) @map("created_at")

  actor User @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([actionType])
  @@index([createdAt])
  @@map("audit_logs")
}

// Cấu hình vận hành chỉnh được từ CMS "Cài Đặt" (menu mẹ, vd. Cài đặt SePay)
// thay vì chỉ qua biến môi trường — key-value để mở rộng thêm mục cài đặt
// khác sau này mà không cần migration mới. `value` là JSON tự do theo từng
// key (vd. key="sepay" → { bankId, bankAccountNumber, bankAccountName,
// webhookApiKey }). Đọc/ghi qua SettingsService, không truy cập trực tiếp.
model SystemSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by")

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("system_settings")
}
