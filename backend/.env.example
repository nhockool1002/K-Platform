# Backend (NestJS) — dùng khi chạy `pnpm dev:backend` trực tiếp trên host
# (Postgres/Redis lấy từ `docker compose -f docker-compose.dev.yml up -d`).
# Copy thành backend/.env (đã có sẵn .gitignore, không commit).

DATABASE_URL="postgresql://kplatform:kplatform_dev_password@localhost:5432/kplatform_dev?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
JWT_ACCESS_SECRET="dev-only-change-me-access"
JWT_REFRESH_SECRET="dev-only-change-me-refresh"

# Phase 2 — SePay (FN-PAY-01). Webhook URL cần khai trên dashboard SePay:
# <domain-backend>/api/v1/payments/sepay-webhook — chọn xác thực "API Key",
# dán đúng giá trị SEPAY_WEBHOOK_API_KEY bên dưới. SEPAY_BANK_ID theo mã ngân
# hàng VietQR (vd. "Vietcombank", "MBBank") dùng để dựng URL ảnh QR img.vietqr.io.
SEPAY_WEBHOOK_API_KEY="dev-only-change-me-sepay-webhook"
SEPAY_BANK_ID=""
SEPAY_BANK_ACCOUNT_NUMBER=""
SEPAY_BANK_ACCOUNT_NAME=""

# Tuỳ chọn — chỉ dùng khi chạy `pnpm prisma:seed`. Không set thì script tự
# sinh ngẫu nhiên và in ra console mỗi lần chạy.
# SEED_DEV_PASSWORD=""

# Phase 4 — Watermark video (FN-TASK-01). Mặc định trỏ tới font cài qua apk
# package `font-dejavu` trong backend/Dockerfile (chỉ có trong container
# Alpine) — set biến này nếu chạy `pnpm dev:backend` trực tiếp trên máy host
# (vd. macOS: thường có sẵn "/System/Library/Fonts/Supplemental/Arial.ttf"
# hoặc cài qua `brew install font-dejavu`).
# WATERMARK_FONT_PATH=""
