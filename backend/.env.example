# Backend (NestJS) — dùng khi chạy `pnpm dev:backend` trực tiếp trên host
# (Postgres/Redis lấy từ `docker compose -f docker-compose.dev.yml up -d`).
# Copy thành backend/.env (đã có sẵn .gitignore, không commit).

DATABASE_URL="postgresql://kplatform:kplatform_dev_password@localhost:5432/kplatform_dev?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
JWT_ACCESS_SECRET="dev-only-change-me-access"
JWT_REFRESH_SECRET="dev-only-change-me-refresh"

# Tuỳ chọn — chỉ dùng khi chạy `pnpm prisma:seed`. Không set thì script tự
# sinh ngẫu nhiên và in ra console mỗi lần chạy.
# SEED_DEV_PASSWORD=""
