# K-Platform — template cho file `.env` đặt TRỰC TIẾP trên VPS, cạnh
# docker-compose.deploy.yml (vd. /www/wwwroot/kplatform-staging/.env).
# KHÔNG commit file .env thật — copy file này rồi điền giá trị thật:
#   cp infra/.env.deploy.example .env
#
# Mỗi môi trường (staging/production) PHẢI có giá trị khác nhau cho mọi
# biến bên dưới — không bao giờ dùng chung DB/Redis/JWT secret giữa 2 môi trường.

# Tên project Docker Compose — nên đặt khác nhau giữa staging/production
# để container/network/volume không trùng tên trên cùng 1 VPS.
COMPOSE_PROJECT_NAME=kplatform-staging

# --- PostgreSQL (nội bộ container, không publish ra host) ---
POSTGRES_USER=kplatform_staging
POSTGRES_PASSWORD=__CHANGE_ME_STRONG_RANDOM__
POSTGRES_DB=kplatform_staging

# --- Backend ---
# Cổng loopback-only trên VPS — PHẢI khác nhau giữa staging/production vì
# chạy chung 1 VPS. Gợi ý: staging=4001, production=4002.
BACKEND_PORT=4001

# Domain frontend (Vercel) của ĐÚNG môi trường này — dùng cho CORS.
FRONTEND_URL=https://staging.kp.nhutnm.id.vn

# Sinh bằng: openssl rand -base64 48
JWT_ACCESS_SECRET=__CHANGE_ME_STRONG_RANDOM__
JWT_REFRESH_SECRET=__CHANGE_ME_STRONG_RANDOM__

# --- Seed demo (tuỳ chọn) ---
# Chỉ đọc khi chạy `... exec -T backend pnpm prisma:seed` thủ công. Không set
# thì mỗi lần seed sẽ sinh mật khẩu ngẫu nhiên khác nhau (in ra console).
# KHÔNG commit giá trị thật của biến này ở đâu cả — kể cả README.
# SEED_DEV_PASSWORD=
