# K-Point Platform — biến môi trường mẫu cho docker-compose.yml.
# Copy thành .env (KHÔNG commit file .env thật) rồi chỉnh giá trị cho từng môi trường.
# Dev chạy FE/BE trực tiếp trên host thì dùng backend/.env.example thay vì file này.

# --- PostgreSQL ---
POSTGRES_USER=kplatform
POSTGRES_PASSWORD=kplatform_dev_password
POSTGRES_DB=kplatform_dev
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Backend (NestJS) ---
BACKEND_PORT=4000
JWT_ACCESS_SECRET=dev-only-change-me-access
JWT_REFRESH_SECRET=dev-only-change-me-refresh

# --- Frontend (Next.js) ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Tích hợp bên thứ ba (điền ở Phase 2 / Phase 6 — xem PLAN.md) ---
# SEPAY_API_KEY=
# SEPAY_WEBHOOK_SECRET=
# BUYMEACOFFEE_PAGE_URL=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# FACEBOOK_OAUTH_CLIENT_ID=
# FACEBOOK_OAUTH_CLIENT_SECRET=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
