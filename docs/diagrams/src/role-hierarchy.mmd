    style RA fill:#1d4e89,color:#ffffff,stroke:#13324f,stroke-width:1px
    style AD fill:#2f6ca2,color:#ffffff,stroke:#13324f,stroke-width:1px
    style MOD fill:#4a90c4,color:#ffffff,stroke:#13324f,stroke-width:1px
    style A fill:#e8a93a,color:#1a1a1a,stroke:#a9760f,stroke-width:1px
    style B fill:#1d4e89,color:#ffffff,stroke:#13324f,stroke-width:1px
