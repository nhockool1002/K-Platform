graph LR
    RA["Root Administrator<br/>(Hard-coded DB ID)"]
    AD["Administrator<br/>(Quyết định tối cao)"]
    MOD["Super / Moderator<br/>(Duyệt Pend App / Pend Reject)"]
    A["Bên A — Advertiser"]
